{
  "name": "redpen-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "RedPen monorepo — React/Vite web + Spring Boot backend for CBSE board-paper marking.",
  "workspaces": [
    "apps/web",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm --workspace=@redpen/web run dev",
    "dev:web": "npm --workspace=@redpen/web run dev",
    "dev:backend": "npm --workspace=redpen-backend run dev",
    "dev:backend:h2": "npm --workspace=redpen-backend run dev:h2",
    "dev:all": "npm-run-all --parallel dev:web dev:backend:h2",
    "start:backend": "npm --workspace=redpen-backend run dev",
    "build:web": "npm --workspace=@redpen/web run build",
    "build:backend": "npm --workspace=redpen-backend run build",
    "test:backend": "npm --workspace=redpen-backend run test",
    "lint": "npm --workspace=@redpen/web run lint",
    "typecheck": "npm --workspace=@redpen/web run typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
