# Copy to apps/backend/.env for local dev. Never commit apps/backend/.env.
# The Gradle plugin doesn't auto-load .env — Spring reads these via the OS env
# in the parent shell, or via an IDE run-configuration. See AGENT.md.

# ── Database (Aiven Postgres shown, replace with your own) ───────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://pg-XXXX.aivencloud.com:23783/defaultdb?sslmode=require
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_AFTER_ROTATION

# ── JWT signing (must be ≥ 32 UTF-8 bytes) ───────────────────────────────
REDPEN_SECURITY_JWT_SECRET=change-me-generate-a-32-plus-byte-random-string
REDPEN_SECURITY_JWT_TTL_HOURS=24

# ── Google OAuth 2.0 (for parent sign-in) ────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) in the Google Cloud Console.
# The backend only needs the *client id* — it verifies ID tokens against Google's public keys.
REDPEN_GOOGLE_CLIENT_ID=XXXXXXXXXXXX.apps.googleusercontent.com

# ── CORS (comma-separated list of allowed web origins) ───────────────────
REDPEN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Payments (leave STUB while wiring; swap to razorpay / stripe later) ──
REDPEN_PAYMENTS_PROVIDER=STUB
# When switching to Razorpay:
REDPEN_PAYMENTS_RAZORPAY_KEY_ID=
REDPEN_PAYMENTS_RAZORPAY_KEY_SECRET=
REDPEN_PAYMENTS_RAZORPAY_WEBHOOK_SECRET=

# ── Gemini AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
