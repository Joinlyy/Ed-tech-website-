# Web env — safe defaults for local dev.
# All VITE_* vars are inlined into the client bundle. Never put secrets here.

VITE_API_BASE_URL=http://localhost:8080/api
VITE_SITE_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (Web app) — same value the backend uses
# to verify the ID token. Get it from Google Cloud Console → APIs & Services →
# Credentials → Create Credentials → OAuth Client ID → Web application.
# Add http://localhost:5173 to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
